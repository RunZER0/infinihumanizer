# ============================================================================
# INFINIHUMANIZER - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=False
OFFLINE_MODE=False

# Humanizer / model runtime
OPENROUTER_API_KEY=your-openrouter-api-key-here
HUMANIZER_BACKEND=openrouter
HUMANIZER_MODEL_ID=mistralai/ministral-3b-2512
HUMANIZER_AUDIT_MODEL_ID=openai/gpt-5-mini
HUMANIZER_SENTENCE_BATCH_SIZE=8
HUMANIZER_MAX_CONCURRENCY=6
HUMANIZER_REQUEST_TIMEOUT=30
HUMANIZER_MAX_RETRIES=2
HUMANIZER_PROVIDER_SORT=throughput
HUMANIZER_DEFAULT_STRENGTH=8
# Optional comma-separated model fallback list
HUMANIZER_FALLBACK_MODELS=

# Optional direct OpenAI backend
OPENAI_API_KEY=

# Database (Render will provide this automatically)
# DATABASE_URL=postgresql://user:password@host:port/database

# Payment Gateway (Paystack)
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Email Configuration (Brevo/Sendinblue)
EMAIL_HOST_USER=your-brevo-login-email
EMAIL_HOST_PASSWORD=your-brevo-smtp-password
DEFAULT_FROM_EMAIL=Infiniai <noreply@yourdomain.com>

# Chunking Configuration (Optional - defaults shown)
ENABLE_CHUNKING=True
CHUNK_MIN_SIZE=200
CHUNK_MAX_SIZE=400
CHUNKING_THRESHOLD=500

# ============================================================================
# RENDER DEPLOYMENT NOTES:
# ============================================================================
# 1. Add these environment variables in your Render dashboard
# 2. Render will automatically provide DATABASE_URL for PostgreSQL
# 3. Set DEBUG=False for production
# 4. Generate a secure SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 5. Make sure to update ALLOWED_HOSTS in settings.py with your Render URL
